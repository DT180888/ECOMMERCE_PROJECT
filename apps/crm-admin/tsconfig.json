{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "src",
    "paths": {
      "@app/*": ["app/*"],
      "@pages/*": ["pages/*"],
      "@components/*": ["components/*"],
      "@hooks/*": ["hooks/*"],
      "@shared/ui": ["components/common/index.ts"],
      "@shared/ui/*": ["components/common/*"],
      "@schemas/*": ["schemas/*"]
    },
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  }
}
