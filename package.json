{
  "name": "ecommerce-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "npm run dev --workspace=@my-project/crm-admin",
    "dev:client": "npm run dev --workspace=@my-project/ecommerce-client",
    "build": "turbo build",
    "build:admin": "npm run build --workspace=@my-project/crm-admin",
    "build:client": "npm run build --workspace=@my-project/ecommerce-client",
    "lint": "turbo lint",
    "preview": "turbo preview"
  },
  "devDependencies": {
    "turbo": "^2.0.4"
  }
}
