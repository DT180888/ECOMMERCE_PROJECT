{
  "name": "ecommerce-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter=@my-project/E-mobile-app",
    "dev:web": "turbo dev --filter=@my-project/ecommerce-client",
    "dev:admin": "turbo dev --filter=@my-project/crm-admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "preview": "turbo preview"
  },
  "devDependencies": {
    "turbo": "^2.0.4"
  }
}
